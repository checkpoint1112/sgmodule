#!name = 📺 BiliBili: 🔀 Redirect - SDJN Fixed CDN
#!desc = 哔哩哔哩：固定重定向至 cn-sdjn-fx-bcache-02.bilivideo.com\n覆盖 OverseaVideo、BStar、PCDN、MCDN 与 Akamai 媒体请求
#!author = Alex Ho / rewritten with M365 Copilot; based on Biliverse Redirect
#!homepage = https://github.com/Biliverse/Redirect
#!icon = https://github.com/Biliverse/Redirect/raw/main/src/assets/icon_rounded.png
#!tag = 🪐 Biliverse
#!system = iOS,iPadOS,macOS,tvOS
#!date = 2026-11-01
#!version = 0.3.0-fixed-sdjn
#!system_version = 15

[Argument]
Enabled = switch,true,tag=[开关] 启用固定 CDN,desc=开启后将匹配到的 Bilibili 视频媒体请求统一重定向到指定 CDN。
TargetCDN = input,"cn-sdjn-fx-bcache-02.bilivideo.com",tag=[主机名] 目标 CDN,desc=只填写主机名，不要填写协议、端口或路径。默认：cn-sdjn-fx-bcache-02.bilivideo.com

[General]
force-http-engine-hosts = *.bilivideo.com:80, *.akamaized.net:80, *.mcdn.bilivideo.cn:8000, *.mcdn.bilivideo.cn:8082, *.mcdn.bilivideo.cn:4483, *.mcdn.bilivideo.cn:9102, *:4480, *:4483, *:8000, *:8082, *:9102

[Rewrite]
# 标准 bilivideo / PCDN / OverseaVideo / BStar：保留协议以外统一改为 HTTPS，保留完整路径、参数和 Range 请求头。
request if ${Enabled} == true && ${url} ~= /^https?:\/\/[^\/]+\.bilivideo\.com(?::(?:80|443|4483))?(\/upgcxcode\/.*)$/i as bili then url.replace("https://${TargetCDN}${bili.1}")

# Akamai 镜像：保留 /upgcxcode/ 后的完整路径和查询参数。
request if ${Enabled} == true && ${url} ~= /^https?:\/\/[^\/]+\.akamaized\.net(?::(?:80|443|4483))?(\/upgcxcode\/.*)$/i as akamai then url.replace("https://${TargetCDN}${akamai.1}")

# MCDN 的 /upgcxcode/ 地址。
request if ${Enabled} == true && ${url} ~= /^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(?::(?:4483|9102))?(\/upgcxcode\/.*)$/i as mcdn_upgc then url.replace("https://${TargetCDN}${mcdn_upgc.1}")

# MCDN 的 /v1/resource/ 地址：目标 CDN 通常使用 /upgcxcode/，先直接保留原路径尝试兼容。
request if ${Enabled} == true && ${url} ~= /^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(?::(?:8000|8082))?(\/v1\/resource\/.*)$/i as mcdn_resource then url.replace("https://${TargetCDN}${mcdn_resource.1}")

# IP/任意主机的 4480 PCDN 地址。
request if ${Enabled} == true && ${url} ~= /^https?:\/\/[^\/]+:4480(\/upgcxcode\/.*)$/i as pcdn then url.replace("https://${TargetCDN}${pcdn.1}")

[MITM]
hostname = %APPEND% *.bilivideo.com, *.mcdn.bilivideo.cn, *.akamaized.net
h2 = true
